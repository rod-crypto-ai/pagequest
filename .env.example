# Optional. Public Google Books searches work without a key but may be rate limited.
GOOGLE_BOOKS_API_KEY=

# Optional override. PageQuest uses the public Gutendex endpoint by default.
GUTENDEX_BASE_URL=

# Required for v0.4 local quiz generation. Keep this server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Leave false until production authentication and rate limiting are complete.
QUIZ_GENERATION_ENABLED=false
